            "type": 68,
            "element_xpath": null,
            "output_variable_name": "tiktokCommentScrollStopStatus",
            "delay": "550,950",
            "continue_on_error": false,
            "id": "d7ad5d57-9a62-43cd-a089-215f961d56cc",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var s=window.__gpmTikTokCommentScroll;if(!s||!s.timer){return 'COMMENT_SCROLL_NOT_STARTED';}clearInterval(s.timer);delete window.__gpmTikTokCommentScroll;return 'COMMENT_SCROLL_STOPPED';} return A();\"}]",
            "comment": "stop random comment scrolling"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 68,
            "element_xpath": null,
            "output_variable_name": "tiktokCommentCloseStatus",
            "delay": "680,860",
            "continue_on_error": false,
            "id": "38574600-c0f1-41f0-9f84-0e5a77cf3753",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var b=document.querySelector('[data-key-interaction=\\\"comment_close\\\"] button[aria-label=\\\"exit\\\"]');if(!b){return 'COMMENT_CLOSE_NOT_FOUND';}b.click();return 'COMMENT_CLOSE_CLICKED';} return A();\"}]",
            "comment": "close TikTok comments"
          },

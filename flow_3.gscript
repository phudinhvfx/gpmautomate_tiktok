            "delay": "660,880",
            "continue_on_error": false,
            "id": "950fe54b-763a-4ae1-b429-adc0d566ce63",
            "display_text": null,
            "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"800\"},{\"Key\":\"MAX\",\"Value\":\"1500\"}]",
            "comment": "wait video snap..."
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",

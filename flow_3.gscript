            "output_variable_name": "tiktokCommentTargetStatus",
            "delay": "750,1200",
            "continue_on_error": false,
            "id": "97ea7c96-c25b-4ed1-86b4-101bc0814b3a",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){document.querySelectorAll('[data-gpm-tiktok-comment-ref]').forEach(function(x){x.removeAttribute('data-gpm-tiktok-comment-ref');});var xs=Array.prototype.slice.call(document.querySelectorAll('article')).filter(function(a){var r=a.getBoundingClientRect();return a.isConnected&&r.width>100&&r.height>100;});if(!xs.length){return 'ARTICLE_NOT_FOUND';}var current=0,best=Infinity;for(var i=0;i<xs.length;i++){var d=Math.abs(xs[i].getBoundingClientRect().top);if(d<best){best=d;current=i;}}var b=xs[current].querySelector('[data-e2e=\\\"comment-icon\\\"][role=\\\"button\\\"]');if(!b){return 'COMMENT_BUTTON_NOT_FOUND';}b.setAttribute('data-gpm-tiktok-comment-ref','1');return 'COMMENT_READY';} return A();\"}]",
            "comment": "mark current TikTok comment"
          },
          {
            "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
            "condition": "$tiktokCommentTargetStatus != \"COMMENT_READY\"",
            "nodes": [
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",

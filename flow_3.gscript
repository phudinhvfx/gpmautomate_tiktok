        "expanded": true,
        "continue_on_error": false,
        "id": "de7b590d-ebb6-417a-8ab6-f8581fd1f8ba",
        "display_text": "Normal block",
        "raw_input": null,
        "comment": "GHI CHÚ FLOW 3\n- Thao tác chính: chuyển mượt đến video TikTok kế tiếp, mở phần Bình luận, chờ 5 giây, cuộn xuống/cuộn lên ngẫu nhiên trong phần bình luận 10 giây, rồi đóng phần bình luận.\n- Flow dùng article kế tiếp thay BrowserMouseScroll để không bị giật từng nấc nhỏ.\n- Sửa thời gian xem bình luận: Block #2 `TikTok: xem bình luận video kế tiếp` → node #7 `wait comments...` (5000ms).\n- Sửa thời gian cuộn comment: Block #2 → node #10 `scroll comments for 10s` (10000ms); nhịp và quãng cuộn ngẫu nhiên nằm trong node #8 `start random comment scrolling`.\n- Cách đếm: dùng số thứ tự block/node hiển thị trong GPM Automate, tính cả block ghi chú này."
      },
      {
        "$type": "GPMAutomateEditor.Models.NormalBlockNode, GPMAutomateEditor.Models",
        "nodes": [
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 68,
            "element_xpath": null,
            "output_variable_name": "tiktokScrollStatus",
            "delay": "550,980",
            "continue_on_error": false,
            "id": "87f5a2f6-3429-425e-9629-fb901071cfe6",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var xs=Array.prototype.slice.call(document.querySelectorAll('article')).filter(function(a){var r=a.getBoundingClientRect();return a.isConnected&&r.width>100&&r.height>100;});if(!xs.length){return 'ARTICLE_NOT_FOUND';}var current=0,best=Infinity;for(var i=0;i<xs.length;i++){var r=xs[i].getBoundingClientRect(),d=Math.abs(r.top);if(d<best){best=d;current=i;}}var next=xs[current+1];if(!next){return 'NEXT_ARTICLE_NOT_FOUND';}next.scrollIntoView({block:'start',behavior:'smooth'});return 'SCROLLED_TO_NEXT_ARTICLE';} return A();\"}]",
            "comment": "scroll next TikTok article"
          },
          {
            "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
            "condition": "$tiktokScrollStatus != \"SCROLLED_TO_NEXT_ARTICLE\"",
            "nodes": [
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 68,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "630,930",
                "continue_on_error": false,
                "id": "83947129-aa77-4b3a-aedb-a6cabb818762",
                "display_text": null,
                "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"window.__gpmFlowRunStatus = 'ERROR:FLOW_3_NEXT_VIDEO_NOT_FOUND';\"}]",
                "comment": "publish next-video error"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 117,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "580,880",
                "continue_on_error": false,
                "id": "e0ce2ad6-bc91-4215-b42e-e05b526d9bd6",
                "display_text": null,
                "raw_input": "[{\"Key\":\"MESSAGE\",\"Value\":\"FLOW_3_NEXT_VIDEO_NOT_FOUND | profile=$profileId | status=$tiktokScrollStatus\"}]",
                "comment": "throw next-video error"
              }
            ],
            "expanded": true,
            "continue_on_error": false,
            "id": "fb64d9ab-4e24-4a13-9237-b73f749f3de0",
            "display_text": "If",
            "raw_input": "[{\"Key\":\"CONDITION\",\"Value\":\"$tiktokScrollStatus != \\\"SCROLLED_TO_NEXT_ARTICLE\\\"\"}]",
            "comment": "throw if next video missing"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 7,

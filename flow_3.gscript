            "type": 7,
            "element_xpath": null,
            "output_variable_name": null,
            "delay": "0,0",
            "continue_on_error": false,
            "id": "bc1c3c5a-16b4-4b82-9d5f-8ce5a9e15a73",
            "display_text": null,
            "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"5000\"},{\"Key\":\"MAX\",\"Value\":\"5000\"}]",
            "comment": "wait comments..."
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 68,
            "element_xpath": null,
            "output_variable_name": "tiktokCommentScrollStatus",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "ea45b25a-1b57-4d20-b46a-69e252739ac6",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var post=document.querySelector('[data-e2e=\\\"comment-post\\\"]');if(!post){return 'COMMENT_PANEL_NOT_FOUND';}var root=post.closest('section');if(!root){return 'COMMENT_PANEL_NOT_FOUND';}var all=Array.prototype.slice.call(root.querySelectorAll('*')),sc=null,best=0;for(var i=0;i<all.length;i++){var e=all[i];if(e.scrollHeight>e.clientHeight+30&&e.clientHeight>best){sc=e;best=e.clientHeight;}}if(!sc){return 'COMMENT_SCROLL_NOT_FOUND';}var old=window.__gpmTikTokCommentScroll;if(old&&old.timer){clearInterval(old.timer);}var until=Date.now()+10000;function tick(){if(Date.now()>=until){clearInterval(window.__gpmTikTokCommentScroll.timer);return;}var max=Math.max(0,sc.scrollHeight-sc.clientHeight),step=160+Math.floor(Math.random()*361),dir=Math.random()<0.5?1:-1,next=Math.max(0,Math.min(max,sc.scrollTop+dir*step));if(Math.abs(next-sc.scrollTop)<10){next=Math.max(0,Math.min(max,sc.scrollTop-dir*step));}sc.scrollTo({top:next,behavior:'smooth'});}tick();var timer=setInterval(tick,800);window.__gpmTikTokCommentScroll={timer:timer,scroll:sc};return 'COMMENT_SCROLL_STARTED';} return A();\"}]",
            "comment": "start random comment scrolling"
          },
          {
            "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",

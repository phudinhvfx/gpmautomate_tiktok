                    "delay": "750,1100",
                    "continue_on_error": false,
                    "id": "7c02ec9f-78f6-4194-b7dc-964a8dd21229",
                    "display_text": null,
                    "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var e=document.querySelector('[data-gpm-tiktok-comment-input=\\\"1\\\"]');if(!e){return 'INPUT_NOT_FOUND';}e.focus();var text=String.raw`$commentContent`;try{document.execCommand('insertText',false,text);}catch(x){return 'INSERT_ERROR';}return 'INSERT_ATTEMPTED';} return A();\"}]",
                    "comment": "insert TikTok comment text"

                    "display_text": null,
                    "raw_input": "[{\"Key\":\"CLICK_TYPE\",\"Value\":\"CLICK_XPATH\"},{\"Key\":\"XPATH\",\"Value\":\"//*[@data-gpm-tiktok-comment-input='1']\"},{\"Key\":\"POS\",\"Value\":\"\"}]",
                    "comment": "focus TikTok comment input"

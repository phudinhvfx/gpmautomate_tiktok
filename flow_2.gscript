                "continue_on_error": false,
                "id": "86a87857-1a23-443e-92fe-84bcd6075c06",
                "display_text": null,
                "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var old=document.querySelectorAll('[data-gpm-tiktok-comment-input]');for(var i=0;i<old.length;i++){old[i].removeAttribute('data-gpm-tiktok-comment-input');}var post=document.querySelector('[data-e2e=\\\"comment-post\\\"]');var root=post&&post.closest('section');if(!root){return 'COMMENT_PANEL_NOT_FOUND';}var es=root.querySelectorAll('[contenteditable=\\\"true\\\"][role=\\\"textbox\\\"]');for(var j=0;j<es.length;j++){var e=es[j],r=e.getBoundingClientRect();if(e.isConnected&&r.width>0&&r.height>0){e.setAttribute('data-gpm-tiktok-comment-input','1');return 'COMMENT_INPUT_READY';}}return 'COMMENT_INPUT_NOT_FOUND';} return A();\"}]",

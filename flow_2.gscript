                "comment": "throw next video failure"
              }
            ],
            "expanded": true,
            "continue_on_error": false,
            "id": "5ecff839-2694-4c20-99e0-77887d7e9174",
            "display_text": "If",
            "raw_input": "[{\"Key\":\"CONDITION\",\"Value\":\"$tiktokScrollStatus != \\\"SCROLLED_TO_NEXT_ARTICLE\\\"\"}]",
            "comment": "stop when next video is unavailable"

                        "continue_on_error": false,
                        "id": "c21f5679-98da-4e4d-9347-0c7ad1221ac8",
                        "display_text": null,
                        "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){function norm(x){return String(x||'').replace(/\\\\s+/g,' ').trim();}if('$tiktokCommentSendStatus'!=='SEND_CLICKED'){return 'COMMENT_SKIPPED';}var s=window.__gpmTikTokCommentProof;if(!s||!s.root||!s.root.isConnected){return 'COMMENT_CONTEXT_LOST';}var xs=Array.prototype.slice.call(s.root.querySelectorAll('[data-e2e=\\\"comment-level-1\\\"]')).filter(function(x){return norm(x.innerText||x.textContent)===s.expected;});var fresh=xs.filter(function(x){return s.before.indexOf(x)<0||s.added.some(function(a){return a===x||x.contains(a)||a.contains(x);});});if(fresh.length===0){return 'COMMENT_NOT_VISIBLE';}fresh[0].setAttribute('data-gpm-tiktok-comment-body','1');return 'COMMENT_PUBLISHED';} return A();\"}]",
                        "comment": "verify published TikTok comment"
                      },

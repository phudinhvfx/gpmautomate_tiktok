                    "element_xpath": null,
                    "output_variable_name": "tiktokCommentDraftStatus",
                    "delay": "540,840",
                    "continue_on_error": false,
                    "id": "f029f0a3-a4a4-4841-981f-0e2c969e4d14",
                    "display_text": null,
                    "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var e=document.querySelector('[data-gpm-tiktok-comment-input=\\\"1\\\"]');if(!e){return 'INPUT_NOT_FOUND';}var t=(e.innerText||e.textContent||'').replace(/\\\\s+/g,' ').trim();return t?'DRAFT_PRESENT: '+t.slice(0,120):'DRAFT_EMPTY';} return A();\"}]",
                    "comment": "verify TikTok comment draft"
                  },
                  {
                    "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
                    "condition": "$tiktokCommentDraftStatus contains \"DRAFT_PRESENT:\"",
                    "nodes": [
                      {
                        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                        "type": 68,
                        "element_xpath": null,
                        "output_variable_name": "tiktokCommentPublishBaselineStatus",
                        "delay": "450,850",
                        "continue_on_error": false,
                        "id": "7d82704a-9561-4bf4-bc4f-d0cbb18a0962",
                        "display_text": null,
                        "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){function norm(x){return String(x||'').replace(/\\\\s+/g,' ').trim();}var input=document.querySelector('[data-gpm-tiktok-comment-input=\\\"1\\\"]'),post=document.querySelector('[data-e2e=\\\"comment-post\\\"]'),root=post&&post.closest('section');if(!input||!root){return 'PUBLISH_CONTEXT_NOT_FOUND';}var expected=norm(input.innerText||input.textContent);if(!expected){return 'COMMENT_TEXT_EMPTY';}var old=window.__gpmTikTokCommentProof;if(old&&old.observer){old.observer.disconnect();}var before=Array.prototype.slice.call(root.querySelectorAll('[data-e2e=\\\"comment-level-1\\\"]')).filter(function(x){return norm(x.innerText||x.textContent)===expected;});var s={root:root,expected:expected,before:before,added:[]};s.observer=new MutationObserver(function(ms){for(var i=0;i<ms.length;i++){s.added.push(ms[i].target);for(var j=0;j<ms[i].addedNodes.length;j++){if(ms[i].addedNodes[j].nodeType===1){s.added.push(ms[i].addedNodes[j]);}}}});s.observer.observe(root,{childList:true,subtree:true,characterData:true});window.__gpmTikTokCommentProof=s;return 'PUBLISH_BASELINE_READY';} return A();\"}]",
                        "comment": "capture TikTok comment baseline"
                      },
                      {
                        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                        "type": 68,
                        "element_xpath": null,
                        "output_variable_name": "tiktokCommentSendStatus",
                        "delay": "0,0",
                        "continue_on_error": false,
                        "id": "e85e2e68-d3ec-4ea1-92df-b491a0b4c6d5",
                        "display_text": null,
                        "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var post=document.querySelector('[data-e2e=\\\"comment-post\\\"][data-key-interaction=\\\"comment_submit\\\"]');if(!post){return 'COMMENT_SEND_BUTTON_NOT_FOUND';}if(post.disabled||post.getAttribute('aria-disabled')==='true'){return 'COMMENT_SEND_BUTTON_DISABLED';}post.click();return 'SEND_CLICKED';} return A();\"}]",
                        "comment": "click TikTok post comment"
                      },
                      {
                        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",

            "continue_on_error": false,
            "id": "cc0a0fd3-38d1-44d1-af02-0b7a1565d8fc",
            "display_text": null,
            "raw_input": "[{\"Key\":\"FILE_OR_CODE\",\"Value\":\"function A(){var old=document.querySelectorAll('[data-gpm-tiktok-comment-ref]');for(var j=0;j<old.length;j++){old[j].removeAttribute('data-gpm-tiktok-comment-ref');}var xs=Array.prototype.slice.call(document.querySelectorAll('article')).filter(function(a){var r=a.getBoundingClientRect();return a.isConnected&&r.width>100&&r.height>100;});if(!xs.length){return 'ARTICLE_NOT_FOUND';}xs.sort(function(a,b){var ra=a.getBoundingClientRect(),rb=b.getBoundingClientRect();return Math.abs(ra.top)-Math.abs(rb.top);});var post=xs[0],button=post.querySelector('[data-e2e=\\\"comment-icon\\\"][role=\\\"button\\\"]');if(!button){return 'COMMENT_BUTTON_NOT_FOUND';}var ref='gpm-tiktok-'+Date.now()+'-'+Math.floor(Math.random()*1000000);post.setAttribute('data-gpm-tiktok-post-ref',ref);button.setAttribute('data-gpm-tiktok-comment-ref',ref);return 'COMMENT_BUTTON_READY';} return A();\"}]",
            "comment": "mark current video comment button"
